# The template is the one .env file that is meant to be committed -- it holds
# no secrets, and README's setup step starts from `cp .env.example .env.local`,
# which cannot work on a fresh clone while this stays ignored. The negation has
# to come after `.env*`, which would otherwise match it.
!.env.example
dist/

# Local scratch and one-off data exports. The *_rows.csv files are dumps of the
# live chat tables -- they carry visitor names, emails and message bodies, so
# they must never reach the public repo.
*_rows.csv
tmp_*.html
projects-template.zip
# Stray copies left at the repo root / components dir by earlier ports. The real
# components are src/components/chat/ChatText.tsx and src/components/ui/Stack.tsx.
/ChatText.tsx
/src/components/Stack.jsx
/src/components/Stack.css
/src/components/Stack.d.ts
