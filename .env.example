# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored by default in Vite projects -- never commit
# a real key to the repo.
#
# The chat needs BOTH a Gemini key (to answer) and Supabase (to persist the
# conversation and power the admin inbox). With only the Gemini key the widget
# still works, but every message is lost on reload and /chat-inbox is empty.

# ---------------------------------------------------------------------------
# Required for the chat to answer at all
# ---------------------------------------------------------------------------
# Server-side only. Never expose this to the browser -- it is read in
# api/chat.ts, which is the only thing that talks to Gemini.
# Get a free key at https://aistudio.google.com/apikey
# Without it, api/chat.ts returns 500 "Server is missing GEMINI_API_KEY".
GEMINI_API_KEY=

# Optional -- override the model without touching api/chat.ts.
# Check https://ai.google.dev/gemini-api/docs/models for whatever's
# current and free-tier-eligible when you deploy.
# If the configured model 404s, api/chat.ts falls back through its built-in
# candidate list, so a stale value degrades rather than breaking the chat.
GEMINI_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# Supabase -- conversation persistence and the admin inbox
# ---------------------------------------------------------------------------
# Server-side. Project settings -> API. The service role key bypasses RLS and
# must never be exposed to the browser or committed.
# The anon/publishable key is the one safe for the client: the widget uses it
# for anonymous sign-in, which is what ties a conversation to a visitor so one
# visitor cannot read another's transcript.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Optional aliases, if your project issues the newer key names. Each group is
# tried in order, so setting either is enough:
#   URL      -- SUPABASE_URL, VITE_SUPABASE_URL
#   service  -- SUPABASE_SERVICE_ROLE_KEY, SUPABASE_SECRET_KEY, SUPABASE_SERVICE_KEY
#   client   -- SUPABASE_ANON_KEY, SUPABASE_PUBLISHABLE_KEY, VITE_SUPABASE_ANON_KEY
# Also read for the browser bundle, where the VITE_ prefix is what makes them
# visible to import.meta.env.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Not an env var, but the thing most likely to be missed: Supabase ->
# Authentication -> Providers -> Anonymous must be ENABLED, or signInAnonymously
# fails. The chat then still works, but the conversation is created without a
# session attached, which api/chat.ts cannot match back to the visitor -- so
# they silently stop receiving replies and their reactions never load.

# ---------------------------------------------------------------------------
# Admin inbox (/chat-inbox)
# ---------------------------------------------------------------------------
# One password, typed once in the UI. The server returns a signed session that
# lasts 12 hours and is stored in sessionStorage (this tab only) -- the
# password itself is never persisted in the browser.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# This MUST be set on every deployment, preview included: when it is unset,
# api/chat.ts returns 503 rather than falling back to a default, because a
# committed fallback password plus a public preview URL would be full inbox
# access for anyone who has read this repository. The "dev-admin" fallback
# applies only to a local dev server with no Vercel/CI environment at all.
CHAT_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Email notification on new conversations (optional)
# ---------------------------------------------------------------------------
# Sent through Resend. Leave RESEND_API_KEY empty and notifications are
# skipped silently -- the chat itself is unaffected.
CHAT_NOTIFICATION_EMAIL=iandevsu@gmail.com
# Verified Resend "from" address. Must be on a domain you have verified, or
# Resend rejects the send.
CHAT_NOTIFICATION_FROM=
RESEND_API_KEY=
# Alternative to Resend: a plain JSON POST to this URL on each new
# conversation. Useful if you would rather not hold a sending key.
CHAT_NOTIFICATION_WEBHOOK=

# ---------------------------------------------------------------------------
# Local development only
# ---------------------------------------------------------------------------
# Port the dev server proxies /api to. 0 (the default) picks a free one, so
# you normally do not need to set this.
CHAT_DEV_API_PORT=
# Absolute origin of the deployed API, for when the frontend and the serverless
# function are served from different places. Leave empty on Vercel, where they
# share an origin; api/chat.ts is then reached at /api/chat.
VITE_API_BASE_URL=
