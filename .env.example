GEMINI_API_KEY=
GEMINI_MODEL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: overrides the API base URL the browser calls. Empty = same origin.
VITE_API_BASE_URL=

# Optional: port the local chat API binds to in "npm run dev". Default 8787.
CHAT_DEV_API_PORT=

CHAT_NOTIFICATION_EMAIL=
CHAT_NOTIFICATION_FROM=
# Optional: alternative webhook for new-chat notifications.
CHAT_NOTIFICATION_WEBHOOK=
RESEND_API_KEY=

# Required everywhere, including local development. There is no fallback value,
# so the admin inbox returns 503 until this is set in .env.local.
CHAT_ADMIN_PASSWORD=
