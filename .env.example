# Copy this file to .env.local and fill in your real key.
# .env.local is gitignored by default in Vite projects -- never commit
# a real API key to the repo.

# Get a free key at https://aistudio.google.com/apikey


# Optional -- override the model without touching api/chat.ts.
# Check https://ai.google.dev/gemini-api/docs/models for whatever's
# current and free-tier-eligible when you deploy.
GEMINI_MODEL=gemini-3.8-flash

CHAT_NOTIFICATION_EMAIL=iandevsu@gmail.com
CHAT_NOTIFICATION_WEBHOOK=
RESEND_API_KEY=
CHAT_NOTIFICATION_FROM=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
CHAT_ADMIN_TOKEN=
